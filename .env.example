NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Daily email digest (server-side only; never prefix with NEXT_PUBLIC_) ---
# Resend API key (https://resend.com). Free tier is enough.
RESEND_API_KEY=
# Optional. Defaults to "TaskFlow <onboarding@resend.dev>" (can only email your own Resend account address).
EMAIL_FROM=
# Supabase "service_role" key (Project Settings > API). Bypasses RLS: keep it secret.
SUPABASE_SERVICE_ROLE_KEY=
# Any long random string. The same value goes in the GitHub secret CRON_SECRET.
CRON_SECRET=

# --- Google Calendar sync (server-side only; optional) ---
# From Google Cloud Console > Google Auth Platform > Clients (a "Web application" client).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Any long random string. Encrypts stored Google tokens; changing it disconnects everyone.
GOOGLE_TOKEN_KEY=
